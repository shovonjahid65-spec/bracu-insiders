# Copy to .env and set the three secrets, or use start.ps1 / start.sh to generate them.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
ADMIN_USERNAME=editor
ADMIN_PASSWORD=
HTTP_PORT=8080
COOKIE_SECURE=false
SEED_EDITION=true
FORWARDED_HEADERS=none
# Only set this to the address pattern of your TLS proxy when native forwarding is enabled.
TRUSTED_PROXY_REGEX=127[.]0[.]0[.]1
